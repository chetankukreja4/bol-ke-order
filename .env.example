# Optional. Copy to .env and fill in. The app runs without any keys.
# Never commit the real .env file.

# Speech-to-text for live mic and uploaded recordings (Hindi/English/Hinglish): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# With the key set, the live mic also uses Sarvam (better Hinglish + noise). Defaults:
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_STT_MODE=translit
# SARVAM_STT_LANG=hi-IN


# Port inside the container. Most cloud hosts set this for you.
# PORT=8000
# Port on your own computer when using docker compose.
# HOST_PORT=8000

# Where orders are stored. Point this at a persistent disk in the cloud.
# DB_PATH=/data/orders.db

# Shop PIN for a public link (asked once per phone). Empty = no PIN.
# BKO_PIN=
# Demo copy only: shows "Demo reset" on the Pilot tab (deletes every order). Never on the shop's real app.
# BKO_DEMO=1
# Local Hindi voice for the read-back (python scripts/get_voice.py downloads it; the Dockerfile sets this).
# BKO_VOICE_MODEL=models/hi_IN-pratham-medium.onnx
