# Optional. Copy to .env and fill in. The app runs without any keys.
# Never commit the real .env file.

# Speech-to-text for uploaded recordings (Hindi/English/Hinglish): https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Better field extraction from messy call recordings: https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Port inside the container. Most cloud hosts set this for you.
# PORT=8000
# Port on your own computer when using docker compose.
# HOST_PORT=8000

# Where orders are stored. Point this at a persistent disk in the cloud.
# DB_PATH=/data/orders.db
